{
  "name": "suenyiyang-pi-preset",
  "version": "0.1.2",
  "description": "suenyiyang's personal Pi coding agent preset — extensions, skills, prompts, and themes.",
  "license": "MIT",
  "author": "suenyiyang",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "preset",
    "skills",
    "extensions",
    "prompts",
    "themes"
  ],
  "files": [
    "extensions",
    "skills",
    "prompts",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suenyiyang/suenyiyang-pi.git"
  },
  "bugs": {
    "url": "https://github.com/suenyiyang/suenyiyang-pi/issues"
  },
  "homepage": "https://github.com/suenyiyang/suenyiyang-pi#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@juicesharp/rpiv-btw": "^2.15.0",
    "@pi-agents/loop": "^0.3.1",
    "pi-codex-image-gen": "^0.3.0",
    "pi-codex-tool-folding": "github:suenyiyang/pi-codex-tool-folding#main",
    "pi-spacexai": "^0.4.1",
    "pi-subagents": "^0.84.0",
    "pi-web-access": "^0.46.0"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "node_modules/pi-subagents/index.js",
      "node_modules/pi-web-access/dist",
      "node_modules/@juicesharp/rpiv-btw/index.ts",
      "node_modules/pi-codex-image-gen/index.ts",
      "node_modules/pi-codex-tool-folding/extensions",
      "node_modules/@pi-agents/loop/dist/index.js"
    ],
    "skills": [
      "./skills",
      "node_modules/pi-subagents/skills",
      "node_modules/pi-codex-image-gen/skills",
      "node_modules/@pi-agents/loop/skills"
    ],
    "prompts": [
      "./prompts",
      "node_modules/pi-subagents/prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "bundleDependencies": [
    "@juicesharp/rpiv-btw",
    "pi-codex-image-gen",
    "pi-codex-tool-folding",
    "pi-subagents",
    "pi-web-access",
    "@pi-agents/loop",
    "pi-spacexai"
  ]
}
